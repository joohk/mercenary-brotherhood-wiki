# Generated by wiki-builder/hubs.py — rebuilt on every build
filters:
  or:
    - file.hasTag("item/magical-weapon")
    - file.hasTag("item/melee-weapon")
    - file.hasTag("item/ranged-weapon")
views:
  - type: table
    name: "By type"
    groupBy:
      property: family
      direction: ASC
    order:
      - file.name
      - tier
      - hands
      - damage_type
      - damage_min
      - damage_max
      - price
      - rarity
