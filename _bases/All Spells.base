# Generated by wiki-builder/hubs.py — rebuilt on every build
filters:
  and:
    - 'type == "ability"'
    - file.hasTag("ability/magic")
views:
  - type: table
    name: "By source"
    groupBy:
      property: source_type
      direction: ASC
    order:
      - file.name
      - ap_cost
      - fatigue_cost
      - cooldown_turns
      - uses_per_battle
      - target_type
