# Generated by wiki-builder/hubs.py — rebuilt on every build
filters:
  and:
    - 'type == "enemy"'
views:
  - type: table
    name: "By tier"
    groupBy:
      property: tier
      direction: ASC
    order:
      - file.name
      - faction
      - hp
      - armor
      - threat_cost
      - xp
      - gold
      - stance
      - size
  - type: table
    name: "By faction"
    groupBy:
      property: faction
      direction: ASC
    order:
      - file.name
      - tier
      - hp
      - armor
      - threat_cost
      - xp
      - gold
      - stance
